---
const { name, size = 24, class: className = '' } = Astro.props as { name: string; size?: number; class?: string };
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  'aria-hidden': 'true',
  class: className
};
---
{name === 'web' && <svg {...common}><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c2.1 2.2 3.2 4.9 3.2 8S14.1 17.8 12 20M12 4C9.9 6.2 8.8 8.9 8.8 12S9.9 17.8 12 20"/></g><path fill="#FFF500" d="M11 3h2v2h-2z"/></svg>}
{name === 'file' && <svg {...common}><path fill="#FFF500" d="M6 3h8l4 4v14H6z"/><path fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter" d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"/></svg>}
{name === 'folder' && <svg {...common}><path fill="#FFF500" d="M3 7h7l2 2h9v10H3z"/><path fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter" d="M3 7h7l2 2h9v10H3zM3 7V5h7l2 2"/></svg>}
{name === 'app' && <svg {...common}><rect x="3" y="4" width="18" height="16" fill="#FFF500"/><g fill="none" stroke="#08264A" stroke-width="1.8"><rect x="3" y="4" width="18" height="16"/><path d="M3 9h18M8 9v11"/></g></svg>}
{name === 'script' && <svg {...common}><rect x="3" y="4" width="18" height="16" fill="#FFF500"/><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="4" width="18" height="16"/><path d="m7 10 3 2-3 2M12 15h5"/></g></svg>}
{name === 'search' && <svg {...common}><g fill="none" stroke="#08264A" stroke-width="2" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.2 15.2 5 5"/></g><path fill="#FFF500" d="M8 5h5v2H8z"/></svg>}
{name === 'quick-look' && <svg {...common}><path fill="#FFF500" d="M4 12c2.3-4 5-6 8-6s5.7 2 8 6c-2.3 4-5 6-8 6s-5.7-2-8-6Z"/><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter"><path d="M3 12c2.6-4.3 5.6-6.5 9-6.5s6.4 2.2 9 6.5c-2.6 4.3-5.6 6.5-9 6.5S5.6 16.3 3 12Z"/><circle cx="12" cy="12" r="2.8"/></g></svg>}
{name === 'launch' && <svg {...common}><path fill="#FFF500" d="m8 5 11 7-11 7z"/><path fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter" d="m7 4 12 8-12 8z"/></svg>}
{name === 'context' && <svg {...common}><path fill="#FFF500" d="M3 8h18v4H3z"/><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter"><rect x="3" y="5" width="18" height="4"/><rect x="5" y="10" width="14" height="4"/><rect x="7" y="15" width="10" height="4"/></g></svg>}
{name === 'repeat' && <svg {...common}><path fill="#FFF500" d="M5 7h12v4H5z"/><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><path d="M5 7h12l-2.5-2.5M19 17H7l2.5 2.5M17 7l2.5 2.5M7 17l-2.5-2.5"/></g></svg>}
{name === 'share' && <svg {...common}><path fill="#FFF500" d="M15 4h5v5h-5z"/><g fill="none" stroke="#08264A" stroke-width="1.8" stroke-linejoin="miter"><rect x="4" y="7" width="5" height="5"/><rect x="15" y="4" width="5" height="5"/><rect x="15" y="15" width="5" height="5"/><path d="M9 9.5h3c3 0 4.5-1.5 4.5-3M9 9.5h3c3 0 4.5 1.5 4.5 8"/></g></svg>}
{name === 'resources' && <svg {...common}><path fill="#FFF500" d="M4 4h7v7H4zM13 13h7v7h-7z"/><g fill="none" stroke="#08264A" stroke-width="1.8"><rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/></g></svg>}
