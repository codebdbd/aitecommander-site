---
import BaseLayout from '@/layouts/BaseLayout.astro';

const cases = [
  {
    number: '01',
    title: 'Работа над проектом',
    problem: 'Документы, сайты, папки и программы проекта находятся в разных местах.',
    solution: 'Соберите всё в одной категории проекта.',
    result: 'В следующий раз открываете готовый рабочий контекст вместо повторного поиска.'
  },
  {
    number: '02',
    title: 'Учитель → класс',
    problem: 'Ученикам приходится отдельно отправлять ссылки, файлы, задания и инструкции.',
    solution: 'Преподаватель создаёт готовое учебное рабочее пространство и передаёт его классу.',
    result: 'Все получают одинаковую структуру и одинаковый набор материалов.'
  },
  {
    number: '03',
    title: 'Руководитель → команда',
    problem: 'Каждый сотрудник организует проект по-своему, а онбординг требует повторных объяснений.',
    solution: 'Создайте стандартное рабочее пространство для проекта или роли.',
    result: 'Сотрудники получают одинаковое стартовое окружение.'
  },
  {
    number: '04',
    title: 'Новый проект из шаблона',
    problem: 'Повторяющиеся проекты приходится собирать заново.',
    solution: 'Скопируйте готовую структуру и замените только конкретные ресурсы.',
    result: 'Новый проект начинается с подготовленного рабочего набора.'
  },
  {
    number: '05',
    title: 'Специалист → клиент',
    problem: 'Результаты проекта разбросаны между файлами, ссылками и папками.',
    solution: 'Соберите их в структурированный рабочий набор и передайте клиенту.',
    result: 'Клиент получает понятную организованную среду, а не набор несвязанных вложений.'
  }
];
---
<BaseLayout title="Сценарии использования Aite Commander" description="Как Aite Commander используют для проектов, обучения, команд, шаблонов и передачи организованных рабочих наборов клиентам." locale="ru">
  <section class="section page-intro">
    <div class="container narrow">
      <p class="eyebrow">Сценарии</p>
      <h1>Как используют Aite Commander</h1>
      <p class="lead">Один и тот же принцип работает для личной работы, обучения, команд и повторяющихся процессов: собрать нужные ресурсы вокруг задачи и сохранить готовый контекст.</p>
    </div>
  </section>

  <div class="usecase-list">
    {cases.map((item, index) => (
      <section class:list={['section', 'usecase-section', { 'section-soft': index % 2 === 1 }]}>
        <div class="container">
          <div class="usecase-heading">
            <span class="usecase-number">{item.number}</span>
            <h2>{item.title}</h2>
          </div>
          <div class="usecase-flow">
            <article>
              <span>Проблема</span>
              <p>{item.problem}</p>
            </article>
            <b>→</b>
            <article class="solution">
              <span>Решение</span>
              <p>{item.solution}</p>
            </article>
            <b>→</b>
            <article class="result">
              <span>Результат</span>
              <p>{item.result}</p>
            </article>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section final-cta">
    <div class="container narrow">
      <h2>Создайте своё рабочее пространство</h2>
      <p>Соберите нужные ресурсы вокруг задачи и сохраните готовый контекст для следующего раза — или передайте его другим.</p>
      <a class="button button-primary" href="/ru/download/">Скачать Aite Commander</a>
    </div>
  </section>
</BaseLayout>
