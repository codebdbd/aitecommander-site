---
import BaseLayout from '@/layouts/BaseLayout.astro';
const cases = [
  ['Работа над проектом','Соберите документы, сайты, папки, программы и скрипты проекта в одной категории.'],
  ['Учитель → класс','Передайте классу готовый учебный набор с одинаковой структурой материалов.'],
  ['Руководитель → команда','Подготовьте стандартное рабочее пространство для проекта или онбординга.'],
  ['Новый проект из шаблона','Копируйте готовую структуру и меняйте только ресурсы нового проекта.'],
  ['Специалист → клиент','Передайте организованный результат проекта, а не набор несвязанных вложений.']
];
---
<BaseLayout title="Сценарии Aite Commander" description="Практические сценарии использования Aite Commander для проектов, обучения, команд и повторяющихся процессов." locale="ru">
<section class="section"><div class="container"><p class="eyebrow">Сценарии</p><h1>Как используют Aite Commander</h1><div class="card-grid">{cases.map(([t,b]) => <article class="card"><h2 class="card-title">{t}</h2><p>{b}</p></article>)}</div></div></section>
</BaseLayout>
