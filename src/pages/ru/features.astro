---
import BaseLayout from '@/layouts/BaseLayout.astro';

const blocks = [
  {
    id: 'organization',
    eyebrow: 'Организация',
    title: 'Соберите всё вокруг задачи',
    body: 'Создавайте структуру Сфера → Раздел → Категория → Ресурс и объединяйте в ней сайты, файлы, папки, программы и скрипты.',
    items: ['Drag & Drop', 'Избранное', 'Недавние ресурсы', 'Контекстные меню', 'Создание элементов из пустой области']
  },
  {
    id: 'search',
    eyebrow: 'Поиск и просмотр',
    title: 'Найдите нужное без лишних запусков',
    body: 'Используйте полнотекстовый поиск по имени, URL, заметкам и аргументам, а также расширенный поиск файлов на компьютере. Quick Look позволяет быстро просматривать изображения, PDF, таблицы, DOCX, архивы, код и папки.',
    items: ['Полнотекстовый поиск', 'Поиск файлов', 'Quick Look', 'Фильтры поиска']
  },
  {
    id: 'launch',
    eyebrow: 'Запуск',
    title: 'Открывайте рабочий набор из одного места',
    body: 'Запускайте отдельные ресурсы или отмечайте несколько и открывайте их одновременно. Для веб-ресурсов можно использовать нужные браузеры и профили.',
    items: ['Одиночный запуск', 'Групповой запуск', 'Браузеры', 'Профили браузеров']
  },
  {
    id: 'sharing',
    eyebrow: 'Передача',
    title: 'Создавайте рабочие наборы для себя и других',
    body: 'Копируйте готовые структуры, используйте их как основу для новых задач и экспортируйте для передачи другим пользователям. Пакеты могут включать связанные файлы рабочего пространства.',
    items: ['Раздел — .aitesec', 'Категория — .aitecat', 'Ресурс — .aitelink', 'Копирование и повторное использование']
  },
  {
    id: 'reliability',
    eyebrow: 'Надёжность',
    title: 'Работайте без страха потерять структуру',
    body: 'Undo/Redo помогает отменять изменения, а резервное копирование и восстановление защищают рабочую базу.',
    items: ['Undo / Redo', 'Проверка недоступных URL', 'SQLite backup / restore', 'Проверка целостности резервных копий']
  },
  {
    id: 'personalization',
    eyebrow: 'Персонализация',
    title: 'Настройте Aite Commander под себя',
    body: 'Используйте темы оформления, настраиваемые горячие клавиши и один из шести языков интерфейса.',
    items: ['Темы', 'Горячие клавиши', 'RU / UK / EN / DE / FR / ES']
  }
];
---
<BaseLayout title="Возможности Aite Commander" description="Организация, поиск, Quick Look, групповой запуск, передача рабочих пространств, резервное копирование и персонализация Aite Commander." locale="ru">
  <section class="section page-intro">
    <div class="container narrow">
      <p class="eyebrow">Возможности</p>
      <h1>Возможности Aite Commander</h1>
      <p class="lead">Aite Commander помогает организовать цифровой рабочий контекст, быстро возвращаться к нему и передавать готовые рабочие наборы другим.</p>
    </div>
  </section>

  {blocks.map((block, index) => (
    <section id={block.id} class:list={['section', 'feature-section', { 'section-soft': index % 2 === 1 }]}>
      <div class="container feature-row">
        <div>
          <p class="eyebrow">{block.eyebrow}</p>
          <h2>{block.title}</h2>
          <p class="lead">{block.body}</p>
        </div>
        <ul class="feature-list">
          {block.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  ))}

  <section class="section final-cta">
    <div class="container narrow">
      <h2>Соберите рабочее пространство под свою задачу</h2>
      <p>Скачайте Aite Commander для Windows и соберите первый рабочий контекст.</p>
      <a class="button button-primary" href="/ru/download/">Скачать Aite Commander</a>
    </div>
  </section>
</BaseLayout>
