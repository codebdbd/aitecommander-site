---
import BaseLayout from '@/layouts/BaseLayout.astro';
const items = [
  ['Что такое Aite Commander?', 'Aite Commander — локальный менеджер цифровых рабочих пространств для Windows. Он объединяет сайты, файлы, папки, программы и скрипты вокруг конкретной задачи.'],
  ['Это менеджер закладок?', 'Нет. Веб-ссылки — только один из типов ресурсов. Aite Commander также работает с локальными файлами, папками, программами и скриптами.'],
  ['Какие ресурсы можно добавлять?', 'Web, File, Folder, Program и Script.'],
  ['Можно ли передавать рабочие пространства другим?', 'Да. Разделы, категории и отдельные ресурсы можно экспортировать в пакеты .aitesec, .aitecat и .aitelink.'],
  ['Передаются ли локальные файлы?', 'Пакеты структуры могут включать связанные файлы рабочего пространства. Внешние программы при этом автоматически не устанавливаются.'],
  ['Нужен ли интернет?', 'Для основной работы с локальными ресурсами обязательное подключение к интернету не требуется. Интернет нужен для веб-ресурсов и функций, которые обращаются к сети.'],
  ['Где хранятся данные?', 'Основная рабочая база Aite Commander хранится локально в SQLite на компьютере пользователя.'],
  ['Нужна ли регистрация?', 'Нет. Обязательная облачная учётная запись для работы с Aite Commander не требуется.'],
  ['Какие версии Windows поддерживаются?', 'Windows 10 и Windows 11, 64-bit.'],
  ['Можно ли запускать несколько ресурсов одновременно?', 'Да. Group Launch позволяет отметить несколько ресурсов и открыть их одновременно.'],
  ['Что такое Quick Look?', 'Это быстрый просмотр содержимого прямо из Aite Commander без запуска отдельной программы.'],
  ['Есть ли резервное копирование?', 'Да. Aite Commander поддерживает создание и восстановление резервных копий базы.'],
  ['Программа бесплатная?', 'Да. Проект распространяется с открытым исходным кодом под лицензией GPL-3.0.']
];
---
<BaseLayout title="Частые вопросы — Aite Commander" description="Ответы на основные вопросы об Aite Commander: ресурсы, локальное хранение, передача рабочих пространств, Windows и лицензия." locale="ru">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">FAQ</p>
      <h1>Частые вопросы</h1>
      <div class="faq-list">
        {items.map(([question, answer]) => (
          <details class="faq-item">
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
